[Unit]
Description=BitcoinPIR issuer (credit issuer for Cashu ecash)
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=bpir-issuer
Group=bpir-issuer
UMask=0077
StateDirectory=bitcoinpir-issuer
StateDirectoryMode=0700
ExecStart=/opt/bitcoinpir/issuer/bpir-issuer serve --config /etc/bitcoinpir/issuer/config.toml
Environment=RUST_LOG=info
Restart=on-failure
RestartSec=5
NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=true
PrivateTmp=true
ReadOnlyPaths=/etc/bitcoinpir/issuer

[Install]
WantedBy=multi-user.target
